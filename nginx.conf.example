# Optional. The installer already binds Beacon to port 80,
# so you do not need nginx for a normal dummy VM.
#
# Use this only if you want nginx in front, for example TLS on 443.
# In that case run: sudo ./install.sh --port 8080
# then copy this file to /etc/nginx/conf.d/beacon-dummy.conf and reload nginx.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
