[Unit]
Description=Beacon Dummy DR canary
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=beacon
Group=beacon
EnvironmentFile=-/etc/default/beacon-dummy
WorkingDirectory=/opt/beacon-dummy
ExecStart=/usr/bin/python3 /opt/beacon-dummy/server.py
Restart=always
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
