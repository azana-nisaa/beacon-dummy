[Unit]
Description=Beacon Dummy DR canary
After=network-online.target network.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/beacon-dummy
Environment=BEACON_HOST=0.0.0.0
Environment=BEACON_PORT=80
EnvironmentFile=-/etc/default/beacon-dummy
ExecStart=/usr/bin/python3 /opt/beacon-dummy/server.py
Restart=always
RestartSec=2
PrivateTmp=true

[Install]
WantedBy=multi-user.target
